# Copy this file to ".env" and fill in your keys. Never commit .env to GitHub!

# ---- LLM providers, tried in this order (remove ones you don't use) ----
LLM_PROVIDERS=groq,gemini,ollama

# Groq - free key from https://console.groq.com/keys   (main provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Google Gemini - free key from https://aistudio.google.com/apikey   (backup)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest

# Ollama - runs on your laptop, no key needed. Install from https://ollama.com then: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FAST_MODEL=llama3.2:3b

# ---- Local models (downloaded once from Hugging Face, free) ----
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Better but bigger (1.1 GB) reranker: BAAI/bge-reranker-base
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Retrieval ----
CANDIDATES_K=20
FINAL_K=5
MAX_CONTEXT_TOKENS=2500
DEFAULT_VERSION=v6
USE_LLM_CACHE=1
